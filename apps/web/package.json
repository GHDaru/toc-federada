{
  "name": "toc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interface da toc-federada — React + TypeScript + Vite (specs 002, 004, 005, 007)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
