{
  "app_id": "toc",
  "name": "TOC Federada",
  "description": "Processos de Pensamento da Teoria das Restricoes (ARA, Nuvem de Conflito, ARF, APR, AT, S&T) como aplicacao federada da plataforma GHDaru. Rascunho do ciclo 001: url e origin usam o dominio reservado .example ate o endereco real ser aprovado no gate do ciclo 003 ([DUVIDA] 1 da spec 003); o catalogo toc.* abaixo e aprovado acao a acao no gate do ciclo 006.",
  "owner": "GHDaru",
  "repository": "https://github.com/GHDaru/toc-federada",
  "mode": "embedded",
  "mount": "iframe",
  "url": "https://toc-federada.example/toc/embarcado",
  "origin": "https://toc-federada.example",
  "endpoints": {
    "introspect": "/auth/introspect",
    "openapi": "https://toc-federada.example/aph/openapi.json"
  },
  "theme": {
    "consumes_tenant_tokens": true,
    "tokens_used": [
      "color-primary",
      "color-surface",
      "color-text",
      "color-danger"
    ],
    "fallback": true
  },
